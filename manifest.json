{
    "action": {
        "default_popup": "popup.html",
        "default_title": "Remember you can change the clock style in the options."
    },
    "background": {
        "service_worker": "background.js"
    },
    "description": "A simple digital clock. (Remember you can change the clock style in the options.)",
    "developer": {
        "name": "angelo2008"
    },
    "icons": {
        "128": "icons/128.png",
        "16": "icons/16.png",
        "32": "icons/32.png",
        "64": "icons/64.png"
    },
    "manifest_version": 3,
    "name": "Digital Clock",
    "options_ui": {
        "page": "options.html"
    },
    "permissions": [
        "storage",
        "windows",
        "scripting",
        "activeTab"
    ],
    "update_url": "https://extension-updates.opera.com/api/omaha/update/",
    "version": "2.0.0"
}